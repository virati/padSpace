#!/usr/bin/env python3
"""List what is on each KDE virtual desktop, per screen.

Queries KWin over D-Bus with a one-shot scripting probe, reads the reply off
the kwin_wayland journal (KWin scripts have no other output channel), and
enriches terminal/editor windows with the `claude` sessions running inside
them by walking /proc ancestry.

With --banner it instead throws a short summary of the current desktop onto
the top of the screen for 30 seconds.

Usage:  ls-ws [--json] [--all] [--timeout SECS]
        ls-ws --banner [TEXT] [--banner-secs N] [--screen NAME]
"""
import json
import os
import subprocess
import sys
import time

KWIN_UNIT = "plasma-kwin_wayland.service"
SCRIPT_NAME = "wsprobe"
BANNER_CLASS = "ls-ws-banner"
BANNER_SECS = 30.0
BANNER_MARGIN = 24
# KWin runs on the host, where the real home is /var/home; inside the
# claudebox toolbox /home/vinConst is the same tree under a different path.
JS_PATH = os.path.realpath(os.path.expanduser("~/.local/share/wsprobe.js"))
if JS_PATH.startswith("/home/") and os.path.isdir("/var/home"):
    JS_PATH = "/var" + JS_PATH

# Windows that are never worth naming in a banner.
BORING = {"xwaylandvideobridge", BANNER_CLASS}

FRIENDLY = {
    "org.kde.konsole": "Konsole",
    "org.kde.dolphin": "Dolphin",
    "google-chrome": "Chrome",
    "org.mozilla.firefox": "Firefox",
    "com.slack.Slack": "Slack",
    "code": "VS Code",
    "steam": "Steam",
    "ai.elementlabs.lmstudio": "LM Studio",
}

PROBE_JS = r"""
var out = [];
var so = workspace.screenOrder || workspace.screens;
var cur = [];
for (var s = 0; s < so.length; s++) {
    cur.push(so[s].name + "=" + workspace.currentDesktopForScreen(so[s]).x11DesktopNumber);
}
var active = (workspace.activeWindow && workspace.activeWindow.output)
    ? workspace.activeWindow.output.name : "";
var ws = workspace.windowList();
for (var i = 0; i < ws.length; i++) {
    var w = ws[i];
    if (!w.normalWindow) continue;
    var ds = [];
    if (w.onAllDesktops) {
        ds.push("ALL");
    } else if (w.desktops) {
        for (var j = 0; j < w.desktops.length; j++) ds.push(w.desktops[j].x11DesktopNumber);
    }
    out.push([ds.join(","),
              (w.output && w.output.name) ? w.output.name : "?",
              w.resourceClass,
              w.minimized ? "min" : "vis",
              w.pid,
              w.caption].join("|"));
}
console.error("WSPROBE-BEGIN|" + workspace.desktops.length + "|" + cur.join(",")
              + "|" + so.length + "|" + active);
for (var k = 0; k < out.length; k++) console.error("WSPROBE-W|" + out[k]);
console.error("WSPROBE-END");
"""

# Wayland gives a client no way to place its own window, so the banner is
# drawn wherever KWin first put it and moved here — the same geometry route
# the daemon uses to shift windows between outputs.
PLACE_JS = r"""
var target = "%(screen)s";
var margin = %(margin)d;
var so = workspace.screenOrder || workspace.screens;
var out = so[0];
for (var i = 0; i < so.length; i++) if (so[i].name === target) out = so[i];
var g = out.geometry;
var placed = 0;
var ws = workspace.windowList();
for (var i = 0; i < ws.length; i++) {
    var w = ws[i];
    if (w.resourceClass !== "%(cls)s") continue;
    var fg = w.frameGeometry;
    var width = Math.min(fg.width, g.width - 2 * margin);
    w.desktops = [workspace.currentDesktopForScreen(out)];
    w.frameGeometry = {
        x: g.x + Math.round((g.width - width) / 2),
        y: g.y + margin,
        width: width,
        height: fg.height
    };
    w.keepAbove = true;
    w.skipTaskbar = true;
    w.skipPager = true;
    w.skipSwitcher = true;
    placed++;
}
console.error("WSPROBE-BEGIN|place");
console.error("WSPROBE-W|" + placed);
console.error("WSPROBE-END");
"""

USE_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def c(code, text):
    return "\033[%sm%s\033[0m" % (code, text) if USE_COLOR else text


def die(msg, code=1):
    print("ls-ws: " + msg, file=sys.stderr)
    sys.exit(code)


def busctl(*args):
    return subprocess.run(
        ["busctl", "--user", "call", "org.kde.KWin", "/Scripting",
         "org.kde.kwin.Scripting"] + list(args),
        capture_output=True, text=True)


def journal_cursor():
    out = subprocess.run(
        ["journalctl", "--user", "-u", KWIN_UNIT, "-n", "0",
         "--show-cursor", "--no-pager"],
        capture_output=True, text=True).stdout
    for line in out.splitlines():
        if line.startswith("-- cursor: "):
            return line[len("-- cursor: "):].strip()
    die("could not read a journal cursor for " + KWIN_UNIT)


def kwin_run(js, timeout):
    """Run a KWin script and return the lines it reported.

    KWin scripting has no return channel, so the script's console.error()
    output is read back off the kwin_wayland journal.
    """
    try:
        with open(JS_PATH) as fh:
            current = fh.read()
    except OSError:
        current = None
    if current != js:
        os.makedirs(os.path.dirname(JS_PATH), exist_ok=True)
        with open(JS_PATH, "w") as fh:
            fh.write(js)

    cursor = journal_cursor()
    try:
        busctl("unloadScript", "s", SCRIPT_NAME)
        load = busctl("loadScript", "ss", JS_PATH, SCRIPT_NAME)
        if load.returncode != 0:
            die("KWin refused the script: " + load.stderr.strip())
        # start() only starts scripts that are not already running, so this
        # does not disturb the persistent padspace-events script.
        busctl("start")

        # Poll rather than `journalctl -f`: follow mode falls back to a 500 ms
        # wait on this machine, while a fresh read lands in ~30 ms.
        deadline = time.monotonic() + timeout
        delay = 0.0
        while time.monotonic() < deadline:
            if delay:
                time.sleep(delay)
            delay = min(delay * 1.6 + 0.004, 0.05)
            out = subprocess.run(
                ["journalctl", "--user", "-u", KWIN_UNIT, "--after-cursor",
                 cursor, "-o", "cat", "--no-pager"],
                capture_output=True, text=True).stdout
            if "WSPROBE-END" not in out:
                continue
            lines, started = [], False
            for line in out.splitlines():
                if line.startswith("WSPROBE-BEGIN"):
                    lines, started = [line], True
                elif started and line.startswith("WSPROBE-W|"):
                    lines.append(line)
                elif started and line == "WSPROBE-END":
                    return lines
        die("timed out after %gs waiting for KWin to answer" % timeout)
    finally:
        busctl("unloadScript", "s", SCRIPT_NAME)


def parse(lines):
    head = lines[0].split("|")
    ndesk = int(head[1])
    current = {}
    for tok in head[2].split(","):
        if "=" in tok:
            name, num = tok.split("=", 1)
            current[name] = int(num)
    screens = [t.split("=")[0] for t in head[2].split(",") if "=" in t]
    active_screen = head[4] if len(head) > 4 else ""

    windows = []
    for line in lines[1:]:
        parts = line.split("|", 6)
        if len(parts) < 7:
            continue
        _, desks, output, cls, state, pid, caption = parts
        if cls == BANNER_CLASS:
            continue
        windows.append({
            "desktops": [d for d in desks.split(",") if d],
            "screen": output,
            "app": cls,
            "minimized": state == "min",
            "pid": int(pid) if pid.isdigit() else None,
            "title": caption,
        })
    return ndesk, screens, current, active_screen, windows


def ancestors(pid, limit=12):
    """Walk up /proc parent links, yielding each ancestor pid."""
    out = []
    for _ in range(limit):
        try:
            with open("/proc/%d/stat" % pid) as fh:
                # comm may contain spaces and parens; ppid is the field after
                # the state letter that follows the final ')'.
                data = fh.read()
            ppid = int(data[data.rindex(")") + 2:].split()[1])
        except (OSError, ValueError, IndexError):
            break
        if ppid <= 1:
            break
        out.append(ppid)
        pid = ppid
    return out


def claude_sessions():
    """Map each running `claude` process to its cwd and ancestor pids."""
    home = os.path.expanduser("~")
    sessions = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        pid = int(entry)
        try:
            with open("/proc/%d/comm" % pid) as fh:
                if fh.read().strip() != "claude":
                    continue
            cwd = os.readlink("/proc/%d/cwd" % pid)
        except OSError:
            continue
        short = cwd
        for prefix in ("/var" + home, home):
            if short == prefix:
                short = "~"
                break
            if short.startswith(prefix + "/"):
                short = "~" + short[len(prefix):]
                break
        sessions.append({"pid": pid, "cwd": short, "ancestors": set(ancestors(pid))})
    return sessions


def attach_sessions(windows, sessions):
    by_pid = {}
    for w in windows:
        if w["pid"]:
            by_pid.setdefault(w["pid"], []).append(w)
        w["claude"] = []
    for s in sessions:
        for anc in s["ancestors"]:
            if anc in by_pid:
                for w in by_pid[anc]:
                    w["claude"].append(s["cwd"])
                break
        else:
            s["orphan"] = True
    return [s for s in sessions if s.get("orphan")]


def summarise(desktop, screen, windows, limit=3, width=110):
    """One very short line describing a desktop: what is on it, nothing else."""
    here = [w for w in windows
            if w["screen"] == screen
            and (str(desktop) in w["desktops"] or "ALL" in w["desktops"])
            and w["app"] not in BORING]
    if not here:
        return "D%d · empty" % desktop

    seen, parts = set(), []
    for w in here:
        name = FRIENDLY.get(w["app"], w["app"])
        if w["claude"]:
            # A session in $HOME has no project to name, so just say what it is.
            projects = sorted({"claude" if p == "~" else p.rsplit("/", 1)[-1]
                               for p in w["claude"]})
            name += " (%s)" % ", ".join(projects)
        if name in seen:
            continue
        seen.add(name)
        parts.append(name)

    shown, rest = parts[:limit], len(parts) - limit
    text = "D%d · %s" % (desktop, " · ".join(shown))
    if rest > 0:
        text += " · +%d more" % rest
    return text if len(text) <= width else text[:width - 1] + "…"


def banner_helper():
    """Find ls-ws-banner next to this script, else on PATH."""
    here = os.path.join(os.path.dirname(os.path.realpath(__file__)), "ls-ws-banner")
    if os.access(here, os.X_OK):
        return here
    from shutil import which
    found = which("ls-ws-banner")
    if not found:
        die("ls-ws-banner not found next to ls-ws or on PATH")
    return found


def show_banner(text, seconds, screen, timeout):
    proc = subprocess.Popen(
        [banner_helper(), text, str(seconds)],
        stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)

    js = PLACE_JS % {"screen": screen, "margin": BANNER_MARGIN,
                     "cls": BANNER_CLASS}
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if proc.poll() is not None:
            err = (proc.stderr.read() or "").strip()
            die("banner helper exited early" + (": " + err if err else ""))
        lines = kwin_run(js, timeout)
        if len(lines) > 1 and lines[1] != "WSPROBE-W|0":
            return True
        time.sleep(0.05)
    # The banner is up and readable, just wherever KWin first put it.
    print("ls-ws: could not place the banner at the top of %s" % screen,
          file=sys.stderr)
    return False


def render(ndesk, screens, current, windows, orphans, show_all):
    cur_txt = "  ".join("%s → desktop %d" % (s, current[s])
                        for s in screens if s in current)
    print("%s · now: %s" % (c("1", "%d desktops" % ndesk), cur_txt))

    for d in range(1, ndesk + 1):
        here = [w for w in windows
                if str(d) in w["desktops"] or "ALL" in w["desktops"]]
        if not here and not show_all:
            continue
        marks = [s for s in screens if current.get(s) == d]
        tag = "  " + c("32", "← current on " + ", ".join(marks)) if marks else ""
        if not here:
            print("\n%s%s\n  (empty)" % (c("1", "Desktop %d" % d), tag))
            continue
        print("\n%s%s" % (c("1", "Desktop %d" % d), tag))
        for w in sorted(here, key=lambda x: (x["screen"], x["app"])):
            extra = []
            if w["minimized"]:
                extra.append("minimized")
            if "ALL" in w["desktops"]:
                extra.append("all desktops")
            if w["claude"]:
                extra.append("claude: " + ", ".join(sorted(set(w["claude"]))))
            suffix = "  " + c("36", "[%s]" % "; ".join(extra)) if extra else ""
            print("  %s %-22s %s%s"
                  % (c("2", "%-10s" % w["screen"]), w["app"][:22],
                     w["title"], suffix))

    if orphans:
        print("\n" + c("1", "claude sessions with no window"))
        for s in orphans:
            print("  pid %-8d %s" % (s["pid"], s["cwd"]))


VALUE_FLAGS = ("--timeout", "--banner-secs", "--screen")
BARE_FLAGS = ("--json", "--all", "--banner")


def parse_args(argv):
    opts = {"json": False, "all": False, "timeout": 3.0, "banner": False,
            "banner_text": None, "banner_secs": BANNER_SECS, "screen": None}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        elif arg == "--json":
            opts["json"] = True
        elif arg == "--all":
            opts["all"] = True
        elif arg == "--banner":
            opts["banner"] = True
            # --banner takes optional text: the next argument, unless that is
            # itself a flag.
            if i + 1 < len(argv) and not argv[i + 1].startswith("-"):
                i += 1
                opts["banner_text"] = argv[i]
        elif arg in VALUE_FLAGS:
            if i + 1 >= len(argv):
                die("%s needs a value" % arg)
            i += 1
            if arg == "--screen":
                opts["screen"] = argv[i]
            else:
                key = "timeout" if arg == "--timeout" else "banner_secs"
                try:
                    opts[key] = float(argv[i])
                except ValueError:
                    die("%s needs a number" % arg)
        elif arg.startswith("-"):
            die("unknown option " + arg)
        else:
            die("unexpected argument %r (banner text needs --banner)" % arg)
        i += 1
    if opts["banner_text"] is not None and not opts["banner"]:
        die("banner text given without --banner")
    return opts


def main():
    opts = parse_args(sys.argv[1:])

    ndesk, screens, current, active_screen, windows = parse(
        kwin_run(PROBE_JS, opts["timeout"]))
    orphans = attach_sessions(windows, claude_sessions())

    if opts["banner"]:
        screen = opts["screen"] or active_screen or (screens[0] if screens else "")
        if screen not in screens:
            die("no such screen %r (have: %s)" % (screen, ", ".join(screens)))
        text = opts["banner_text"] or summarise(
            current.get(screen, 0), screen, windows)
        show_banner(text, opts["banner_secs"], screen, opts["timeout"])
        print("%s  (%s, %gs)" % (text, screen, opts["banner_secs"]))
        return

    if opts["json"]:
        print(json.dumps({
            "desktops": ndesk,
            "screens": screens,
            "active_screen": active_screen,
            "current": current,
            "windows": windows,
            "claude_without_window": [
                {"pid": s["pid"], "cwd": s["cwd"]} for s in orphans],
        }, indent=2))
    else:
        render(ndesk, screens, current, windows, orphans, opts["all"])


if __name__ == "__main__":
    main()
